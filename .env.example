# URL del sitio (para SEO y Open Graph)
# En Vercel: https://tu-proyecto.vercel.app
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Número de WhatsApp (formato: código país + código área + número)
# Ejemplo: 5491112345678 (Argentina)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Teléfono para JSON-LD (formato internacional)
# Ejemplo: +54-9-11-1234-5678
NEXT_PUBLIC_PHONE=
